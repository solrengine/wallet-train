#!/usr/bin/env ruby

# Runs the Solana WebSocket monitor as a standalone process.
# Monitors all active users' wallets for account changes
# and broadcasts updates via Turbo Streams + Solid Cable.

require_relative "../config/environment"

puts "[SolanaMonitor] Starting on #{SolanaConfig.network}"
puts "[SolanaMonitor] RPC: #{SolanaConfig.rpc_url.sub(/api-key=.*/, 'api-key=***')}"
puts "[SolanaMonitor] WS:  #{SolanaConfig.ws_url.sub(/api-key=.*/, 'api-key=***')}"

# Verify Solid Cable is working
Turbo::StreamsChannel.broadcast_replace_to("_ping", target: "_ping", html: "")
puts "[SolanaMonitor] Solid Cable broadcast OK"

monitors = {}

loop do
  active_wallets = User.where("updated_at > ?", 1.hour.ago).pluck(:wallet_address)

  # Start monitors for new wallets
  active_wallets.each do |wallet|
    next if monitors[wallet]

    puts "[SolanaMonitor] Subscribing to #{wallet}"
    monitor = SolanaWebsocketMonitor.new(wallet)

    # Start in a thread since `start` now blocks
    Thread.new { monitor.start }
    monitors[wallet] = monitor
  end

  # Stop monitors for inactive wallets
  monitors.each do |wallet, monitor|
    unless active_wallets.include?(wallet)
      puts "[SolanaMonitor] Unsubscribing from #{wallet}"
      monitor.stop
      monitors.delete(wallet)
    end
  end

  sleep 30
rescue => e
  puts "[SolanaMonitor] Error: #{e.message}"
  sleep 5
end
