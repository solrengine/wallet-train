<%= turbo_stream_from "wallet_#{@wallet_address}" %>

<div class="min-h-screen bg-gradient-to-br from-gray-950 via-gray-900 to-purple-950">
  <%# Navigation %>
  <nav class="border-b border-gray-800 bg-gray-900/50 backdrop-blur sticky top-0 z-10">
    <div class="max-w-2xl mx-auto px-4 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <%= link_to dashboard_path, class: "text-gray-400 hover:text-white transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        <% end %>
        <h1 class="text-lg font-bold text-white">Send SOL</h1>
      </div>
      <span class="text-gray-500 text-xs font-mono"><%= @network.capitalize %></span>
    </div>
  </nav>

  <div class="max-w-lg mx-auto px-4 py-8">
    <div class="bg-gray-800/50 backdrop-blur border border-gray-700 rounded-2xl p-6"
         data-controller="transfer"
         data-transfer-create-url-value="<%= transfers_path %>"
         data-transfer-dashboard-url-value="<%= dashboard_path %>"
         data-transfer-wallet-value="<%= @wallet_address %>"
         data-transfer-balance-value="<%= @balance || 0 %>"
         data-transfer-rpc-url-value="<%= current_rpc_url %>">

      <%# Status messages %>
      <div data-transfer-target="status" class="hidden mb-4 p-3 rounded-lg text-sm text-center"></div>

      <%# Available balance %>
      <div class="mb-6 text-center">
        <p class="text-gray-500 text-xs mb-1">Available Balance</p>
        <p class="text-2xl font-bold text-white">
          <%= @balance ? number_with_precision(@balance, precision: 4) : "--" %> SOL
        </p>
      </div>

      <%# Recipient %>
      <div class="mb-4">
        <label class="block text-gray-400 text-xs mb-2">Recipient Address</label>
        <input type="text"
               data-transfer-target="recipient"
               placeholder="Enter Solana wallet address"
               class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm font-mono placeholder-gray-600 focus:outline-none focus:border-purple-500 transition-colors" />
      </div>

      <%# Amount %>
      <div class="mb-6">
        <label class="block text-gray-400 text-xs mb-2">Amount (SOL)</label>
        <div class="relative">
          <input type="number"
                 step="0.000001"
                 min="0"
                 data-transfer-target="amount"
                 placeholder="0.0"
                 class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm font-mono placeholder-gray-600 focus:outline-none focus:border-purple-500 transition-colors pr-16" />
          <button data-action="click->transfer#setMax"
                  class="absolute right-2 top-1/2 -translate-y-1/2 text-purple-400 hover:text-purple-300 text-xs font-semibold cursor-pointer transition-colors px-2 py-1">
            MAX
          </button>
        </div>
      </div>

      <%# Send button %>
      <button data-transfer-target="sendBtn"
              data-action="click->transfer#send"
              class="w-full cursor-pointer bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-200">
        Send SOL
      </button>

      <%# Confirmation state %>
      <div data-transfer-target="confirming" class="hidden mt-4">
        <div id="transfer_status" class="text-center">
          <div class="animate-spin w-8 h-8 border-2 border-purple-500 border-t-transparent rounded-full mx-auto mb-3"></div>
          <p class="text-gray-300 text-sm" data-transfer-target="confirmingText">Waiting for wallet approval...</p>
        </div>
      </div>

      <%# Success state %>
      <div data-transfer-target="success" class="hidden mt-4">
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-green-900/30 flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <p class="text-white font-medium mb-1">Transaction Sent!</p>
          <a data-transfer-target="solscanLink" href="#" target="_blank"
             class="text-purple-400 hover:text-purple-300 text-xs font-mono transition-colors">
            View on Solscan
          </a>
          <div class="mt-3">
            <span data-transfer-target="confirmationBadge" class="inline-block px-2 py-1 rounded-full text-xs"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
