<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "WalletTrain — Solana Wallet Built with Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Full-featured Solana wallet built with Ruby on Rails 8. Wallet auth, token portfolio, SOL transfers, and real-time updates. Powered by SolRengine.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%# Open Graph %>
    <meta property="og:title" content="WalletTrain — Solana Wallet Built with Rails">
    <meta property="og:description" content="Full-featured Solana wallet built with Ruby on Rails 8. Wallet auth, token portfolio, SOL transfers, and real-time updates.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://wallet.solrengine.org">
    <meta property="og:image" content="https://wallet.solrengine.org/og-image.png">

    <%# Twitter Card %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="WalletTrain — Solana Wallet Built with Rails">
    <meta name="twitter:description" content="Full-featured Solana wallet built with Ruby on Rails 8. Wallet auth, token portfolio, SOL transfers, and real-time updates.">
    <meta name="twitter:image" content="https://wallet.solrengine.org/og-image.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.png" type="image/png" sizes="180x180">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
