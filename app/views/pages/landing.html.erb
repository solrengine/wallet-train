<div class="min-h-screen bg-gradient-to-br from-gray-950 via-gray-900 to-purple-950">
  <%# Navigation %>
  <nav class="border-b border-gray-800/50">
    <div class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span class="text-xl font-bold text-white">WalletTrain</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://github.com/moviendome/solana-rails-app" target="_blank" class="text-gray-400 hover:text-white text-sm transition-colors">GitHub</a>
        <%= link_to "Launch App", login_path, class: "bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white text-sm font-medium py-2 px-4 rounded-lg transition-all duration-200" %>
      </div>
    </div>
  </nav>

  <%# Hero %>
  <div class="max-w-5xl mx-auto px-6 pt-20 pb-20">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      <%# Left: copy %>
      <div class="flex-1">
        <div class="inline-flex items-center gap-2 bg-purple-900/20 border border-purple-800/30 rounded-full px-3 py-1 mb-6">
          <span class="w-2 h-2 bg-green-400 rounded-full"></span>
          <span class="text-purple-300 text-xs font-medium">Open Source</span>
        </div>

        <h1 class="text-5xl sm:text-6xl font-bold text-white leading-tight mb-6">
          A Solana wallet<br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400">built with Rails</span>
        </h1>

        <p class="text-lg text-gray-400 leading-relaxed mb-10 max-w-xl">
          Full-featured Solana dapp using the Rails 8 default stack. Wallet auth, token portfolio, real-time updates, and transactions.
        </p>

        <div class="flex flex-wrap gap-4">
          <%= link_to login_path, class: "inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-200" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            Connect Wallet
          <% end %>
          <a href="https://github.com/moviendome/solana-rails-app" target="_blank"
             class="inline-flex items-center gap-2 bg-gray-800 hover:bg-gray-700 text-gray-300 font-semibold py-3 px-6 rounded-xl transition-all duration-200 border border-gray-700">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            View Source
          </a>
        </div>
      </div>

      <%# Right: mock wallet UI %>
      <div class="flex-1 w-full max-w-sm">
        <div class="bg-gray-800/50 backdrop-blur border border-gray-700/50 rounded-2xl overflow-hidden shadow-2xl shadow-purple-900/10">
          <%# Header %>
          <div class="px-5 py-4 border-b border-gray-700/50 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
              <span class="text-gray-400 text-xs">Mainnet</span>
            </div>
            <span class="text-gray-500 text-xs font-mono">Fqgr...HC12</span>
          </div>

          <%# Balance %>
          <div class="px-5 pt-5 pb-3">
            <p class="text-gray-500 text-xs mb-1">Portfolio Value</p>
            <p class="text-2xl font-bold text-white hero-balance">$2,847.63</p>
          </div>

          <%# Token list %>
          <div class="divide-y divide-gray-700/30">
            <div class="px-5 py-3 flex items-center justify-between hero-token" style="animation-delay: 0.1s">
              <div class="flex items-center gap-3">
                <%= image_tag "tokens/sol.png", alt: "SOL", class: "w-8 h-8 rounded-full" %>
                <div>
                  <p class="text-white text-sm font-medium">Solana</p>
                  <p class="text-gray-500 text-xs">24.5 SOL</p>
                </div>
              </div>
              <p class="text-white text-sm font-medium">$2,284.65</p>
            </div>

            <div class="px-5 py-3 flex items-center justify-between hero-token" style="animation-delay: 0.2s">
              <div class="flex items-center gap-3">
                <%= image_tag "tokens/usdc.png", alt: "USDC", class: "w-8 h-8 rounded-full" %>
                <div>
                  <p class="text-white text-sm font-medium">USD Coin</p>
                  <p class="text-gray-500 text-xs">412.50 USDC</p>
                </div>
              </div>
              <p class="text-white text-sm font-medium">$412.50</p>
            </div>

            <div class="px-5 py-3 flex items-center justify-between hero-token" style="animation-delay: 0.3s">
              <div class="flex items-center gap-3">
                <%= image_tag "tokens/jup.png", alt: "JUP", class: "w-8 h-8 rounded-full" %>
                <div>
                  <p class="text-white text-sm font-medium">Jupiter</p>
                  <p class="text-gray-500 text-xs">182.3 JUP</p>
                </div>
              </div>
              <p class="text-white text-sm font-medium">$150.48</p>
            </div>

            <div class="px-5 py-3 flex items-center justify-between hero-token" style="animation-delay: 0.4s">
              <div class="flex items-center gap-3">
                <%= image_tag "tokens/bonk.png", alt: "BONK", class: "w-8 h-8 rounded-full" %>
                <div>
                  <p class="text-white text-sm font-medium">Bonk</p>
                  <p class="text-gray-500 text-xs">2.4M BONK</p>
                </div>
              </div>
              <p class="text-white text-sm font-medium">$48.20</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .hero-balance {
      animation: fadeInUp 0.6s ease-out both;
    }
    .hero-token {
      opacity: 0;
      animation: fadeInUp 0.5s ease-out both;
    }
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <%# Features %>
  <div class="max-w-5xl mx-auto px-6 py-20">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold text-white mb-4">Everything you need</h2>
      <p class="text-gray-400 max-w-lg mx-auto">Built with the Rails 8 default stack. No external dependencies beyond what ships with Rails.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%# Feature 1 %>
      <div class="bg-gray-800/30 border border-gray-700/50 rounded-2xl p-6">
        <div class="w-10 h-10 rounded-xl bg-purple-900/30 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Wallet Authentication</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Sign in with any Solana wallet via SIWS. Ed25519 signature verification in Ruby. No passwords.</p>
      </div>

      <%# Feature 2 %>
      <div class="bg-gray-800/30 border border-gray-700/50 rounded-2xl p-6">
        <div class="w-10 h-10 rounded-xl bg-blue-900/30 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Token Portfolio</h3>
        <p class="text-gray-400 text-sm leading-relaxed">SOL and SPL token balances with icons, names, and USD prices from Jupiter. Metadata persisted in DB.</p>
      </div>

      <%# Feature 3 %>
      <div class="bg-gray-800/30 border border-gray-700/50 rounded-2xl p-6">
        <div class="w-10 h-10 rounded-xl bg-green-900/30 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Real-time Updates</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Solana WebSocket subscriptions push balance changes instantly via ActionCable and Turbo Streams.</p>
      </div>

      <%# Feature 4 %>
      <div class="bg-gray-800/30 border border-gray-700/50 rounded-2xl p-6">
        <div class="w-10 h-10 rounded-xl bg-yellow-900/30 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Send SOL</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Rails validates, @solana/kit builds the transaction, wallet signs it. Confirmation tracked via background job.</p>
      </div>

      <%# Feature 5 %>
      <div class="bg-gray-800/30 border border-gray-700/50 rounded-2xl p-6">
        <div class="w-10 h-10 rounded-xl bg-red-900/30 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Solid Everything</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Solid Cache for RPC responses, Solid Queue for background jobs, Solid Cable for WebSocket broadcasts. All SQLite.</p>
      </div>

      <%# Feature 6 %>
      <div class="bg-gray-800/30 border border-gray-700/50 rounded-2xl p-6">
        <div class="w-10 h-10 rounded-xl bg-pink-900/30 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>
        <h3 class="text-white font-semibold mb-2">Rails 8 Default Stack</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Hotwire, Turbo, Stimulus, Tailwind, esbuild, Kamal. No React. No external infrastructure. Just Rails.</p>
      </div>
    </div>
  </div>

  <%# Code snippets %>
  <div class="max-w-5xl mx-auto px-6 py-20">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold text-white mb-4">Looks like Rails, talks to Solana</h2>
      <p class="text-gray-400 max-w-lg mx-auto">Standard Rails patterns you already know. No new framework to learn.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <%# Code: SIWS Verification %>
      <div class="bg-gray-900/80 border border-gray-700/50 rounded-2xl overflow-hidden">
        <div class="px-4 py-2.5 border-b border-gray-700/50 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/60"></span>
          <span class="text-gray-500 text-xs ml-2">siws_verifier.rb</span>
        </div>
        <pre class="p-4 text-xs leading-relaxed"><code class="text-gray-300"><span class="text-purple-400">class</span> <span class="text-blue-300">SiwsVerifier</span>
  <span class="text-purple-400">def</span> <span class="text-yellow-300">verify!</span>
    verify_message_format!
    verify_domain!
    verify_signature!
  <span class="text-purple-400">end</span>

  <span class="text-purple-400">def</span> <span class="text-yellow-300">verify_signature!</span>
    pubkey = <span class="text-blue-300">Base58</span>.base58_to_binary(addr)
    key = <span class="text-blue-300">Ed25519::VerifyKey</span>.new(pubkey)
    key.verify(signature, message)
  <span class="text-purple-400">end</span>
<span class="text-purple-400">end</span></code></pre>
      </div>

      <%# Code: Sessions Controller %>
      <div class="bg-gray-900/80 border border-gray-700/50 rounded-2xl overflow-hidden">
        <div class="px-4 py-2.5 border-b border-gray-700/50 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/60"></span>
          <span class="text-gray-500 text-xs ml-2">sessions_controller.rb</span>
        </div>
        <pre class="p-4 text-xs leading-relaxed"><code class="text-gray-300"><span class="text-purple-400">def</span> <span class="text-yellow-300">create</span>
  verifier = <span class="text-blue-300">SiwsVerifier</span>.new(
    wallet_address: params[<span class="text-green-400">:wallet</span>],
    message: params[<span class="text-green-400">:message</span>],
    signature: params[<span class="text-green-400">:signature</span>]
  )

  <span class="text-purple-400">if</span> verifier.verify
    session[<span class="text-green-400">:user_id</span>] = user.id
  <span class="text-purple-400">end</span>
<span class="text-purple-400">end</span></code></pre>
      </div>

      <%# Code: Real-time %>
      <div class="bg-gray-900/80 border border-gray-700/50 rounded-2xl overflow-hidden">
        <div class="px-4 py-2.5 border-b border-gray-700/50 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/60"></span>
          <span class="text-gray-500 text-xs ml-2">show.html.erb</span>
        </div>
        <pre class="p-4 text-xs leading-relaxed"><code class="text-gray-300"><span class="text-gray-500">&lt;%=</span> <span class="text-yellow-300">turbo_stream_from</span> <span class="text-green-400">"wallet_#&#123;@address&#125;"</span> <span class="text-gray-500">%&gt;</span>

<span class="text-gray-500">&lt;%=</span> render <span class="text-green-400">"portfolio_value"</span> <span class="text-gray-500">%&gt;</span>
<span class="text-gray-500">&lt;%=</span> render <span class="text-green-400">"token_list"</span> <span class="text-gray-500">%&gt;</span>
<span class="text-gray-500">&lt;%=</span> render <span class="text-green-400">"recent_activity"</span> <span class="text-gray-500">%&gt;</span></code></pre>
      </div>

      <%# Code: Stimulus + @solana/kit %>
      <div class="bg-gray-900/80 border border-gray-700/50 rounded-2xl overflow-hidden">
        <div class="px-4 py-2.5 border-b border-gray-700/50 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/60"></span>
          <span class="text-gray-500 text-xs ml-2">transfer_controller.js</span>
        </div>
        <pre class="p-4 text-xs leading-relaxed"><code class="text-gray-300"><span class="text-purple-400">import</span> { <span class="text-blue-300">pipe</span>,
  <span class="text-blue-300">createTransactionMessage</span>,
  <span class="text-blue-300">compileTransaction</span>
} <span class="text-purple-400">from</span> <span class="text-green-400">"@solana/kit"</span>

<span class="text-purple-400">const</span> tx = <span class="text-yellow-300">pipe</span>(
  createTransactionMessage({ <span class="text-blue-300">version</span>: <span class="text-green-400">0</span> }),
  tx => setFeePayer(sender, tx),
  tx => appendInstruction(ix, tx),
)</code></pre>
      </div>
    </div>
  </div>

  <%# CTA %>
  <div class="max-w-5xl mx-auto px-6 py-20 text-center">
    <h2 class="text-3xl font-bold text-white mb-4">Rails meets Solana</h2>
    <p class="text-gray-400 mb-8 max-w-lg mx-auto">WalletTrain is open source and MIT licensed. Connect your wallet and try it, or dive into the source.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <%= link_to login_path, class: "inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white font-semibold py-3 px-6 rounded-xl transition-all duration-200" do %>
        Try the Demo
      <% end %>
      <a href="https://github.com/moviendome/solana-rails-app" target="_blank"
         class="inline-flex items-center gap-2 text-gray-400 hover:text-white font-semibold py-3 px-6 rounded-xl transition-colors">
        Star on GitHub
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>

  <%# Support %>
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="bg-gray-800/20 border border-gray-700/30 rounded-2xl p-8 text-center"
         data-controller="donate"
         data-donate-recipient-value="EViz4YGrY6GZtfu35Y1Q3PoFWAhoXY6YMHFrcneMbdCF"
         data-donate-rpc-url-value="<%= SolanaConfig.rpc_url %>">

      <p class="text-gray-400 text-sm mb-2">Support this project</p>
      <p class="text-gray-600 text-xs mb-5">Send SOL directly from your wallet</p>

      <%# Amount cards %>
      <div class="flex flex-wrap justify-center gap-3 mb-5">
        <% [0.1, 0.5, 1, 5].each do |amount| %>
          <button data-action="click->donate#donate"
                  data-amount="<%= amount %>"
                  class="bg-gray-800 hover:bg-gray-700 border border-gray-700 hover:border-purple-500 text-white font-medium py-2.5 px-5 rounded-xl cursor-pointer transition-all duration-200 text-sm">
            <%= amount %> SOL
          </button>
        <% end %>
      </div>

      <%# Status message %>
      <p data-donate-target="status" class="hidden text-xs mt-3"></p>

      <%# Manual address copy %>
      <div class="mt-4 pt-4 border-t border-gray-700/30">
        <p class="text-gray-600 text-xs mb-2">Or send any amount to</p>
        <button data-controller="clipboard"
                data-clipboard-text-value="EViz4YGrY6GZtfu35Y1Q3PoFWAhoXY6YMHFrcneMbdCF"
                data-action="click->clipboard#copy"
                class="inline-flex items-center gap-2 text-gray-400 hover:text-white font-mono text-xs cursor-pointer transition-colors">
          <span data-clipboard-target="label">EViz4...bdCF</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <%# Footer %>
  <footer class="border-t border-gray-800/50">
    <div class="max-w-5xl mx-auto px-6 py-8 flex items-center justify-between">
      <div class="flex items-center gap-2 text-gray-500 text-sm">
        <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        WalletTrain
      </div>
      <div class="flex items-center gap-4 text-gray-500 text-sm">
        <a href="https://github.com/moviendome/solana-rails-app" target="_blank" class="hover:text-white transition-colors">GitHub</a>
        <span class="text-gray-700">MIT License</span>
      </div>
    </div>
  </footer>
</div>
