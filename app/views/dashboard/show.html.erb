<%= turbo_stream_from "wallet_#{@wallet_address}" %>

<div class="min-h-screen bg-gradient-to-br from-gray-950 via-gray-900 to-purple-950">
  <%# Navigation %>
  <nav class="border-b border-gray-800 bg-gray-900/50 backdrop-blur sticky top-0 z-10">
    <div class="max-w-2xl mx-auto px-4 py-4 flex items-center justify-between">
      <h1 class="text-lg font-bold text-white">Solana on Rails</h1>
      <div class="flex items-center gap-3">
        <%# Network selector %>
        <div class="relative" data-controller="dropdown">
          <button data-action="click->dropdown#toggle" class="flex items-center gap-1.5 text-xs text-gray-400 bg-gray-800 hover:bg-gray-700 px-2.5 py-1.5 rounded-lg cursor-pointer transition-colors">
            <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
            Mainnet
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div data-dropdown-target="menu" class="hidden absolute right-0 mt-1 w-32 bg-gray-800 border border-gray-700 rounded-lg shadow-xl overflow-hidden">
            <div class="px-3 py-2 text-xs text-white bg-purple-900/30 cursor-default">Mainnet</div>
            <div class="px-3 py-2 text-xs text-gray-400 hover:bg-gray-700 cursor-pointer">Devnet</div>
            <div class="px-3 py-2 text-xs text-gray-400 hover:bg-gray-700 cursor-pointer">Testnet</div>
          </div>
        </div>

        <%# Wallet address (click to copy) %>
        <button data-controller="clipboard"
                data-clipboard-text-value="<%= @wallet_address %>"
                data-action="click->clipboard#copy"
                class="text-gray-400 text-xs font-mono bg-gray-800 hover:bg-gray-700 px-2.5 py-1.5 rounded-lg cursor-pointer transition-colors flex items-center gap-1.5">
          <span data-clipboard-target="label"><%= @short_address %></span>
          <svg data-clipboard-target="icon" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </button>

        <%# Disconnect %>
        <%= button_to "Disconnect", logout_path, method: :delete, class: "text-gray-500 hover:text-white text-xs cursor-pointer transition-colors" %>
      </div>
    </div>
  </nav>

  <div class="max-w-2xl mx-auto px-4 py-8 space-y-6" data-controller="auto-refresh" data-auto-refresh-interval-value="60">
    <%= render "dashboard/portfolio_value", total_usd: @total_usd %>
    <%= render "dashboard/token_list", tokens: @tokens %>
    <%= render "dashboard/recent_activity", transactions: @transactions, wallet_address: @wallet_address %>
  </div>
</div>
