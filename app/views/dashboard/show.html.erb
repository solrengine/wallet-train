<div class="min-h-screen bg-gradient-to-br from-gray-950 via-gray-900 to-purple-950">
  <%# Navigation %>
  <nav class="border-b border-gray-800 bg-gray-900/50 backdrop-blur">
    <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
      <h1 class="text-xl font-bold text-white">Solana on Rails</h1>
      <div class="flex items-center gap-4">
        <span class="text-gray-400 text-sm font-mono bg-gray-800 px-3 py-1 rounded-lg">
          <%= @short_address %>
        </span>
        <%= button_to "Disconnect", logout_path, method: :delete, class: "text-gray-400 hover:text-white text-sm transition-colors" %>
      </div>
    </div>
  </nav>

  <%# Dashboard content %>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white mb-2">Dashboard</h2>
      <p class="text-gray-400">Connected as <span class="font-mono text-purple-400"><%= @wallet_address %></span></p>
    </div>

    <%# Balance card %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-gray-800/50 backdrop-blur border border-gray-700 rounded-2xl p-6">
        <p class="text-gray-400 text-sm mb-1">SOL Balance</p>
        <p class="text-3xl font-bold text-white">
          <% if @balance %>
            <%= number_with_precision(@balance, precision: 4) %> SOL
          <% else %>
            <span class="text-gray-500">Unavailable</span>
          <% end %>
        </p>
      </div>

      <div class="bg-gray-800/50 backdrop-blur border border-gray-700 rounded-2xl p-6">
        <p class="text-gray-400 text-sm mb-1">Network</p>
        <p class="text-3xl font-bold text-white flex items-center gap-2">
          <span class="w-2 h-2 bg-green-400 rounded-full"></span>
          Mainnet
        </p>
      </div>
    </div>

    <%# Info section %>
    <div class="mt-8 bg-gray-800/50 backdrop-blur border border-gray-700 rounded-2xl p-6">
      <h3 class="text-lg font-semibold text-white mb-4">What just happened?</h3>
      <ol class="space-y-3 text-gray-300 text-sm">
        <li class="flex gap-3">
          <span class="bg-purple-600 text-white w-6 h-6 rounded-full flex items-center justify-center text-xs shrink-0">1</span>
          Your wallet signed a SIWS (Sign In With Solana) message
        </li>
        <li class="flex gap-3">
          <span class="bg-purple-600 text-white w-6 h-6 rounded-full flex items-center justify-center text-xs shrink-0">2</span>
          Rails verified the Ed25519 signature server-side
        </li>
        <li class="flex gap-3">
          <span class="bg-purple-600 text-white w-6 h-6 rounded-full flex items-center justify-center text-xs shrink-0">3</span>
          A standard Rails session was created &mdash; no passwords, no email
        </li>
        <li class="flex gap-3">
          <span class="bg-purple-600 text-white w-6 h-6 rounded-full flex items-center justify-center text-xs shrink-0">4</span>
          Your SOL balance was fetched server-side via <code class="bg-gray-700 px-1 rounded">solana_rpc_ruby</code>
        </li>
      </ol>
    </div>
  </div>
</div>
