<div id="portfolio_value" class="flex items-end justify-between">
  <div>
    <p class="text-gray-500 text-xs mb-1">Portfolio Value</p>
    <p class="text-3xl font-bold text-white">
      <% if total_usd > 0 %>
        $<%= number_with_precision(total_usd, precision: 2, delimiter: ",") %>
      <% else %>
        --
      <% end %>
    </p>
  </div>
  <%= link_to new_transfer_path, class: "flex items-center gap-1.5 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white text-sm font-medium py-2 px-4 rounded-xl cursor-pointer transition-all duration-200" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
    </svg>
    Send
  <% end %>
</div>
